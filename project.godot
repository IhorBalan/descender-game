[editor_plugins]

enabled=PackedStringArray("res://addons/props_dock/plugin.cfg")

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="light_barrier"
2d_physics/layer_5="ledge"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
viewport/hdr_2d=false
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
environment/defaults/default_clear_color=Color(0.16, 0.13, 0.32, 1)

[live_map]

enabled=true
project_id="lit-pixel-game-k0os"
