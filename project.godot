; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Descender"
config/version="0.1.0"
config/description="A side-view metroidvania prototype: a man with half-finished angel powers descends from Heaven into Hell."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Levels="*res://scripts/levels.gd"
Audio="*res://scripts/audio.gd"
Feedback="*res://scripts/feedback.gd"
SaveManager="*res://scripts/save_manager.gd"
Prompts="*res://scripts/prompts.gd"
Settings="*res://scripts/settings.gd"
LiveMap="*res://scripts/live_map.gd"
MapStore="*res://scripts/map_store.gd"
ComponentStore="*res://scripts/component_store.gd"
DevConsole="*res://scripts/dev_console.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

