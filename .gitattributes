# Normalize line endings
* text=auto eol=lf

# Godot files
*.gd text
*.tscn text
*.tres text
*.godot text
*.import text

# Binary assets
*.png binary
*.wav binary
*.ogg binary

# Unity files
*.cs text diff=csharp
