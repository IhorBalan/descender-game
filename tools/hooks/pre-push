#!/bin/sh
# Runs the Unity EditMode and PlayMode tests before a push, so the tests gate
# the repository without Unity running in CI (CI has no Unity licence).
#
# Install once per clone:   git config core.hooksPath tools/hooks
# Skip once:                SKIP_UNITY_TESTS=1 git push      (or git push --no-verify)
# Pick the editor:          UNITY_EDITOR=/path/to/Unity git push
# Stall limit in seconds:   PRE_PUSH_STALL_SECONDS=600 (the default)
#
# The editor is found from ProjectSettings/ProjectVersion.txt under the Unity
# Hub's install folder. The project must not be open in the editor at the same
# time; run the tests from Window > General > Test Runner instead then.
#
# The tests run headless in batch mode, never in a visible editor window, in
# three -runTests launches (the test runner exits on its own; no -quit):
#   EditMode                        with -nographics
#   PlayMode, not [Category("Rendering")]   with -nographics
#   PlayMode, [Category("Rendering")]       without -nographics: it renders
#                                           offscreen, still with no window
# Each writes Logs/pre-push-<run>.xml and Logs/pre-push-<run>.log. The push is
# refused unless every run ran tests and none failed; the failing tests, their
# messages and the error lines of the log are printed.
#
# A run gets PRE_PUSH_TIMEOUT_SECONDS (600) in all and PRE_PUSH_STALL_SECONDS
# (600) without any progress; past either, the editor is killed and the end of
# its log printed. Before the first run, a batch-mode editor left over on this
# project from an earlier run is killed and a stale lock removed. An editor
# that someone opened on the project is never closed: the hook says so and
# stops, since Unity cannot open one project twice.
#
# While a run goes, the hook prints its phase (starting, importing, running
# the tests) and the time elapsed, and how long the last passing run took.
#
# On Windows the editor is started through unity-background.ps1 (next to this
# file), with its windows hidden: even in batch mode the editor opens a console
# window, which otherwise takes the keyboard and mouse from whatever is in use,
# a game for one. PRE_PUSH_FOREGROUND=1 starts the editor directly instead.
# Burst compilation is off: the tests do not need it, and on Windows with Smart
# App Control each blocked Burst DLL raises a notification with a sound.

set -u

hook_dir=$(cd "$(dirname "$0")" && pwd)

if [ "${SKIP_UNITY_TESTS:-}" != "" ]; then
    echo "pre-push: SKIP_UNITY_TESTS is set, skipping the Unity tests."
    exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

version=$(sed -n 's/^m_EditorVersion: *//p' ProjectSettings/ProjectVersion.txt | tr -d '\r')
if [ -z "$version" ]; then
    echo "pre-push: cannot read the editor version from ProjectSettings/ProjectVersion.txt." >&2
    exit 1
fi

unity="${UNITY_EDITOR:-}"
if [ -z "$unity" ]; then
    for candidate in \
        "/Applications/Unity/Hub/Editor/$version/Unity.app/Contents/MacOS/Unity" \
        "$HOME/Unity/Hub/Editor/$version/Editor/Unity" \
        "/opt/unity/editors/$version/Editor/Unity" \
        "/c/Program Files/Unity/Hub/Editor/$version/Editor/Unity.exe" \
        "C:/Program Files/Unity/Hub/Editor/$version/Editor/Unity.exe"
    do
        if [ -x "$candidate" ]; then
            unity="$candidate"
            break
        fi
    done
fi
if [ -z "$unity" ] || [ ! -x "$unity" ]; then
    echo "pre-push: Unity $version was not found. Install it through Unity Hub or set UNITY_EDITOR." >&2
    echo "pre-push: to push without the tests: SKIP_UNITY_TESTS=1 git push" >&2
    exit 1
fi

# unity_on_project: one line per editor process that has this project open,
# "<pid> batch" for a command-line run and "<pid> editor" for an open editor.
unity_on_project() {
    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*)
            win_root=$(cygpath -w "$root" 2>/dev/null || echo "$root")
            DESCENDER_ROOT="$win_root" powershell.exe -NoProfile -Command '
                $root = $env:DESCENDER_ROOT.TrimEnd([char]92).ToLowerInvariant()
                Get-CimInstance Win32_Process | Where-Object { $_.Name -eq "Unity.exe" } | ForEach-Object {
                    $line = ([string]$_.CommandLine).Replace([char]47, [char]92).ToLowerInvariant()
                    # A path given with a trailing slash names the same project.
                    $line = $line.Replace([string][char]92 + [char]34, [string][char]34).Replace([string][char]92 + " ", " ").TrimEnd([char]92)
                    # The path itself, not one it is a prefix of (descender-focus vs descender-focus2).
                    if ($line.Contains($root + [char]34) -or $line.Contains($root + " ") -or $line.EndsWith($root)) {
                        if ($line.Contains("-batchmode")) { "$($_.ProcessId) batch" } else { "$($_.ProcessId) editor" }
                    }
                }' 2>/dev/null | tr -d '\r'
            ;;
        *)
            ps -axo pid=,args= 2>/dev/null | grep -F "$root" | grep -E "[U]nity( |$)|Unity\.app" | grep -v pre-push |
                awk '{ kind = ($0 ~ /-batchmode/) ? "batch" : "editor"; print $1, kind }'
            ;;
    esac
}

# kill_pid <pid>: ends a stray editor and everything it started.
kill_pid() {
    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) taskkill //F //T //PID "$1" >/dev/null 2>&1 ;;
        *) kill -9 "$1" 2>/dev/null ;;
    esac
}

found=$(unity_on_project)
if echo "$found" | grep -q " editor$"; then
    echo "pre-push: the project is open in a Unity editor (pid $(echo "$found" | awk '/ editor$/ { print $1 }' | tr '\n' ' ')), and Unity cannot open it twice." >&2
    echo "pre-push: close that editor yourself and push again; the hook does not close it." >&2
    exit 1
fi
for stray in $(echo "$found" | awk '/ batch$/ { print $1 }'); do
    echo "pre-push: killing a batch-mode editor left over on this project (pid $stray)."
    kill_pid "$stray"
done
if [ -n "$found" ]; then
    sleep 2
fi
if [ -f Temp/UnityLockfile ] && ! rm -f Temp/UnityLockfile 2>/dev/null; then
    echo "pre-push: Temp/UnityLockfile is held by a process the hook does not recognise; close it and push again." >&2
    exit 1
fi

mkdir -p Logs
last_file="Logs/pre-push-last-seconds.txt"
stall_limit="${PRE_PUSH_STALL_SECONDS:-600}"
time_limit="${PRE_PUSH_TIMEOUT_SECONDS:-600}"
started=$(date +%s)
unity_pid=""

trap 'stop_unity; exit 1' INT TERM

# Stops the editor at once and clears what a stopped editor leaves behind: its
# lock, which the next run would take for an open editor, and the PlayMode
# bootstrap scene. On Windows kill alone only sends the editor a Ctrl-C, after
# which it spends up to a minute shutting down (and crashing on the way), so
# its process tree is ended with taskkill first.
stop_unity() {
    if [ -z "$unity_pid" ]; then
        return
    fi
    if [ -r "/proc/$unity_pid/winpid" ]; then
        taskkill //F //T //PID "$(cat "/proc/$unity_pid/winpid")" >/dev/null 2>&1
    fi
    kill "$unity_pid" 2>/dev/null
    wait "$unity_pid" 2>/dev/null
    unity_pid=""
    # A killed editor on Windows holds its lock for a moment longer.
    for attempt in 1 2 3 4 5; do
        rm -f Temp/UnityLockfile Assets/InitTestScene*.unity Assets/InitTestScene*.unity.meta 2>/dev/null && break
        sleep 1
    done
}

# 75 -> 1m15s
clock() {
    printf '%dm%02ds' $(($1 / 60)) $(($1 % 60))
}

# What the editor is doing now, from its log: "kind|text".
phase_of() {
    if grep -q "Running tests for\|RunStarted\|Executing tests" "$1" 2>/dev/null; then
        echo "test|running the tests"
        return
    fi
    imported=$(grep -cE "^Start importing |Importing .GUID: |Imported GUID: " "$1" 2>/dev/null)
    if [ "${imported:-0}" -gt 0 ]; then
        echo "import|importing assets ($imported so far)"
    else
        echo "start|starting the editor"
    fi
}

# start_unity <unity arguments...>: starts the editor and sets unity_pid. On
# Windows that is the pid of unity-background.ps1, which starts the editor
# with its windows hidden (so it cannot take the foreground), exits with the
# editor's exit code and takes the editor down with it when it is killed.
start_unity() {
    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) direct="${PRE_PUSH_FOREGROUND:-}" ;;
        *) direct=1 ;;
    esac
    if [ -n "$direct" ]; then
        "$unity" "$@" &
    else
        powershell.exe -NoProfile -ExecutionPolicy Bypass \
            -File "$hook_dir/unity-background.ps1" "$unity" "$@" &
    fi
    unity_pid=$!
}

# run_unity <label> <log> <unity arguments...>: runs the editor, printing a
# progress line when the phase changes and every 10 seconds. Returns the
# editor's exit code, or 124 when it was stopped for standing still or for
# running past the time limit.
run_unity() {
    label=$1
    log=$2
    shift 2
    rm -f "$log"
    run_started=$(date +%s)
    start_unity "$@" -logFile "$log"
    kind=""
    beat=0
    quiet=0
    seen=""
    while kill -0 "$unity_pid" 2>/dev/null; do
        sleep 2
        beat=$((beat + 2))
        phase=$(phase_of "$log")
        if [ "${phase%%|*}" != "$kind" ] || [ $beat -ge 10 ]; then
            kind=${phase%%|*}
            beat=0
            echo "pre-push: [$(clock $(($(date +%s) - started)))] $label: ${phase#*|}"
        fi
        now="$(wc -c <"$log" 2>/dev/null) $phase"
        if [ "$now" = "$seen" ]; then
            quiet=$((quiet + 2))
        else
            quiet=0
            seen=$now
        fi
        if [ "$quiet" -ge "$stall_limit" ]; then
            echo "pre-push: nothing has happened for $(clock "$quiet") (${phase#*|}); stopping the editor." >&2
            stop_unity
            return 124
        fi
        if [ $(($(date +%s) - run_started)) -ge "$time_limit" ]; then
            echo "pre-push: $label has run past the limit of $(clock "$time_limit") (${phase#*|}); stopping the editor." >&2
            stop_unity
            return 124
        fi
    done
    wait "$unity_pid"
    code=$?
    unity_pid=""
    # An editor that aborted (a compile error) leaves its lock behind, and the
    # next run would take it for an open editor. Ours has exited, and no other
    # had the project when it started.
    rm -f Temp/UnityLockfile
    return $code
}

# report_failure <platform> <exit code> <log> <results>: why a run failed.
report_failure() {
    echo "pre-push: $1 run failed (exit $2)." >&2
    if ! grep -qE "error CS[0-9]+|<test-case" "$3" "$4" 2>/dev/null; then
        echo "pre-push: no compile error or test result was written; another Unity instance may have the project open, or the editor failed to start. See $3." >&2
    fi
    grep -E "error CS[0-9]+|Scripts have compiler errors" "$3" | sed 's/^.*Assets/Assets/' | sort -u | head -20 >&2
    # The errors and exceptions the editor logged, else the end of the log.
    errors=$(grep -nE "Exception|Error|error |Assert|Failed|Aborting|timed out" "$3" 2>/dev/null |
        grep -vE "error CS[0-9]+|0 errors|ErrorPause|Assert\.cs|\[Licensing" | tail -25)
    if [ -n "$errors" ]; then
        echo "pre-push: lines from $3:" >&2
        echo "$errors" | sed 's/^/  /' >&2
    elif [ -f "$3" ]; then
        echo "pre-push: the end of $3:" >&2
        tail -15 "$3" | sed 's/^/  /' >&2
    fi
    if [ -f "$4" ]; then
        # The failing test names and their messages, from the NUnit XML.
        awk '/<test-case/ && /result="Failed"/ { match($0, /fullname="[^"]*"/); print "  failed: " substr($0, RSTART + 10, RLENGTH - 11) }
             /<message>/ && !/One or more child tests had errors/ { gsub(/.*<message><!\[CDATA\[|\]\]><\/message>.*/, ""); print "    " $0 }' "$4" | head -40 >&2
    fi
}

# count <results> <attribute>: a number from the <test-run> element.
count() {
    sed -n 's/.*<test-run [^>]*[^a-z]'"$2"'="\([0-9]*\)".*/\1/p' "$1" 2>/dev/null | head -1
}

# passed_line <platform> <results>: prints the summary line and succeeds only
# when the results file shows tests that ran and none that failed.
passed_line() {
    passed=$(count "$2" passed)
    failed=$(count "$2" failed)
    if [ ! -f "$2" ] || [ -z "$passed" ] || [ "$passed" -eq 0 ] || [ "${failed:-1}" -ne 0 ]; then
        return 1
    fi
    echo "pre-push: $1 passed ($passed tests)."
}

if [ -f "$last_file" ]; then
    echo "pre-push: the last passing run here took $(clock "$(tr -cd '0-9' <"$last_file")")."
elif [ ! -d Library ]; then
    echo "pre-push: first run in this checkout, so Unity imports the whole project first (a minute or two)."
fi

# Burst would compile the packages' jobs to native DLLs under Library/BurstCache.
# The tests do not need them: the same code runs managed, the game has no Burst
# code of its own, and on Windows with Smart App Control each unsigned DLL is
# blocked with a warning to the user anyway.
burst="--burst-disable-compilation"

# The runs: "<name> <platform> <graphics> <category filter>". The rendering
# run is left out while no PlayMode test is tagged [Category("Rendering")].
runs="EditMode EditMode -nographics -
PlayMode PlayMode -nographics !Rendering"
if grep -rqs --include="*.cs" 'Category("Rendering")' Assets/Tests/PlayMode; then
    runs="$runs
PlayModeRendering PlayMode - Rendering"
fi

status=0
# Read from a here-document, not a pipe, so the loop runs in this shell and
# the INT/TERM trap can still stop the editor.
while read -r name platform graphics category; do
    log="Logs/pre-push-$name.log"
    results="Logs/pre-push-$name.xml"
    rm -f "$results"
    [ "$graphics" = "-" ] && graphics=""
    if [ "$category" = "-" ]; then
        set -- -testPlatform "$platform"
    else
        set -- -testPlatform "$platform" -testCategory "$category"
    fi
    echo "pre-push: running $name (watch with: tail -f $log)."
    # shellcheck disable=SC2086
    run_unity "$name" "$log" -batchmode $burst $graphics -projectPath "$root" -runTests \
        "$@" -testResults "$results" </dev/null
    code=$?
    if [ $code -ne 0 ] || ! passed_line "$name" "$results"; then
        status=1
        report_failure "$name" "$code" "$log" "$results"
        break
    fi
done <<RUNS
$runs
RUNS

total=$(($(date +%s) - started))
if [ $status -ne 0 ]; then
    echo "pre-push: fix the tests, or push without them with SKIP_UNITY_TESTS=1 git push." >&2
else
    echo "$total" >"$last_file"
    echo "pre-push: all tests passed in $(clock "$total")."
fi
exit $status
